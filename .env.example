# SRAF environment configuration
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets to the repo.

# ---- LLM backend ------------------------------------------------------------
# Which extractor to use: openai | llamacpp | vllm
LLM_BACKEND=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000

# ---- OpenAI (required if LLM_BACKEND=openai) --------------------------------
OPENAI_API_KEY=sk-replace-me

# ---- llama.cpp server (required if LLM_BACKEND=llamacpp) --------------------
# LLAMACPP_SERVER_URL=http://localhost:8080

# ---- vLLM server (required if LLM_BACKEND=vllm, used on the cluster) --------
# VLLM_SERVER_URL=http://localhost:8000

# ---- Optional path overrides ------------------------------------------------
# SRAF_DATA_DIR=/custom/path/to/data
# SRAF_OUTPUT_DIR=/custom/path/to/outputs
# SRAF_CORPUS_DIR=/custom/path/to/corpus

# ---- Triplestore connection (defaults work for docker compose) -------------
# OXIGRAPH_HOST=oxigraph
# OXIGRAPH_PORT=7878
