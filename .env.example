# SRAF environment configuration
# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit secrets to the repo.
#
# The sbatch scripts source .env with `set -a; . .env; set +a`, so the LAST
# assignment of a name wins. config.py does NOT read .env by itself, so source
# it in your shell before running anything interactively.

# ---- LLM backend ------------------------------------------------------------
# openai | compat | xai | vllm | llamacpp | google | anthropic
# The first five are OpenAI-compatible and share one implementation pointed at
# different base URLs. google and anthropic use their providers' own schemas.
LLM_BACKEND=google
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000

# ---- Provider credentials ---------------------------------------------------
# One per provider. The N3 frontier sweep needs all four; every other path
# needs only the one its backend uses.
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional endpoint overrides, for proxies or self-hosted gateways.
# OPENAI_BASE_URL=
# XAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# SRAF_COMPAT_BASE_URL=
# SRAF_COMPAT_API_KEY=

# ---- Local model servers ----------------------------------------------------
# LLAMACPP_SERVER_URL=http://localhost:8080     # LLM_BACKEND=llamacpp (Mac)
# VLLM_SERVER_URL=http://localhost:8000         # LLM_BACKEND=vllm (cluster)

# ---- Spend caps -------------------------------------------------------------
# The usage meter is the only guard on API spend. A model with no registered
# price has its tokens counted but cannot be charged against the cap, which
# silently disables the guard, so the preflight reports any unpriced model.
# SRAF_BUDGET_USD=                              # general extraction budget
# SRAF_N3_BUDGET_USD=35                         # the N3 frontier sweep cap

# ---- N3 frontier sweep ------------------------------------------------------
# Provider model identifiers change, and the ids baked into
# rag_pipeline/model_registry.py are the ones the cost plan was built on, not a
# record of what exists today. Trust the preflight's live probe, and override
# here when a provider renames something.
# SRAF_N3_GEMINI_MODEL=
# SRAF_N3_GROK_MODEL=
# SRAF_N3_GPT_MODEL=
# SRAF_N3_SONNET_MODEL=
# SRAF_N3_OPUS_MODEL=
#
# Selection and order. resolve() preserves the order given, and the headline
# claim rests on the three uncontaminated corpus models, so run those first.
# Do NOT pass this inside sbatch --export: that option is itself a
# comma-separated list, so the value would be split. Export it in the shell and
# let --export=ALL carry it.
# SRAF_N3_MODELS=grok,gpt5,sonnet,opus,gemini-flash
# SRAF_N3_LIMIT=0                               # >0 limits studies, for smoke tests
#
# Cost-estimate inputs. Change only if the prompt or schema changes.
# SRAF_N3_CALLS_PER_STUDY=15
# SRAF_N3_PROMPT_TOKENS=845
# SRAF_N3_COMPLETION_TOKENS=297

# ---- Other services ---------------------------------------------------------
# GitHub token. Unauthenticated GitHub allows 60 requests an hour and howfairis
# spends several per repository, so the N2 collector needs this.
APIKEY_GITHUB=

# Hugging Face token, for pulling gated open-weights models in
# cluster/extract_corpus.sbatch. Not used by the N3 hosted-model sweep.
# Already set on the cluster; leave it alone there. Shape: hf_<34 chars>.
HF_TOKEN=

# ---- Triplestore connection -------------------------------------------------
# Defaults suit docker compose. On the cluster the sbatch scripts start
# Oxigraph themselves and bind 127.0.0.1:7878, so set the host accordingly.
# OXIGRAPH_HOST=127.0.0.1
# OXIGRAPH_PORT=7878
# RDIP_NAMESPACE=
# RDIP_GRAPH_BASE=

# ---- Paths and limits -------------------------------------------------------
# SRAF_DATA_DIR=
# SRAF_OUTPUT_DIR=
# SRAF_CORPUS_DIR=
# SRAF_SCRATCH_DIR=
# SRAF_LOG_DIR=
# SRAF_BUILD_TIMEOUT=
# EMBEDDING_MODEL=allenai/specter2_base
# APPTAINER_BIN=
