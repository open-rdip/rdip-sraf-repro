venv/

.env
triplestore/*
!triplestore/.gitkeep
data/papers/
phase4_validation/repos/
logs/
*.faiss
*.pkl
.DS_Store
.embeddings_cache/

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Test repositories (cloned on demand)
test_repos/

# Apptainer image artifacts
*.sif

# Logs
logs/*.log
*.pptx

*.jpg
*.pdf
*.tmp
# result-repro generated outputs.
# The per-study rows ARE the evidence behind the failure taxonomy and the paper
# states they are released, so they must be tracked. Only bulk logs are ignored.
result_repro/results/*
!result_repro/results/rows/
!result_repro/results/summary.json

# more caches / backups
.pytest_cache/
pytest-cache-files-*/
*.bak

# Usage meter run state. prices.json is configuration you set per provider;
# usage.json is per-run accounting and is regenerated by every sweep. The final
# cost record for the paper is exported deliberately, not carried in git.
data/usage/usage.json

# Partial corpus sweep output. Committing a half-finished sweep is how a stale
# results file ends up in a release; the server run writes the complete set.
validation/repo_facts/
